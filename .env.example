# ==============================================================================
# PERFORMai-360: Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - This file contains placeholder values ONLY for local development.
# - NEVER commit real secrets, private keys, API keys, or production credentials.
# - Copy this file to `.env` (backend) or `.env.local` (frontend) for local setup:
#     cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Core Configuration
# ------------------------------------------------------------------------------
APP_NAME="PERFORMai-360"
APP_ENV="development"
DEBUG="true"
HOST="0.0.0.0"
PORT="8000"
API_V1_PREFIX="/api/v1"

# ------------------------------------------------------------------------------
# Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# Generate a secure random key for local development (e.g. `openssl rand -hex 32`)
SECRET_KEY="replace-with-a-secure-random-secret-key-for-local-dev-only"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password_placeholder"
POSTGRES_DB="performai360"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5433"

# Async connection string for FastAPI / SQLAlchemy asyncpg
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password_placeholder@localhost:5433/performai360"

# Synchronous connection string for Alembic migrations
SYNC_DATABASE_URL="postgresql://postgres:postgres_password_placeholder@localhost:5433/performai360"

# ------------------------------------------------------------------------------
# CORS & Allowed Origins
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Evidence & Upload Storage
# ------------------------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="10"

# ------------------------------------------------------------------------------
# LLM / AI Configuration
# ------------------------------------------------------------------------------
# Provider options: mock | openai | anthropic | ollama
# Default for offline development and CI is "mock" (no paid API key required)
LLM_PROVIDER="mock"

# External API Keys (Placeholders only - leave empty or dummy when using mock provider)
OPENAI_API_KEY="sk-placeholder-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

ANTHROPIC_API_KEY="sk-ant-placeholder-anthropic-api-key"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"

LLM_TEMPERATURE="0.1"
LLM_REQUEST_TIMEOUT="60"

# ------------------------------------------------------------------------------
# Frontend Configuration (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_APP_ENV="development"
